@model Lant_Hotelier.Models.Camera

@{
    ViewData["Title"] = "Editează Camera";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 rounded-4 shadow-sm bg-white" style="border: 2px solid #ffdae9 !important;">
            <h2 class="fw-bold text-center mb-4" style="color: #d63384;">🛏️ Editează Camera</h2>

            <form asp-action="Edit" asp-route-lantId="@ViewBag.LantId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ID_Camera" />
                <input type="hidden" asp-for="ID_Lant" value="@ViewBag.LantId" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Tip_Camera" class="fw-bold">Tip Cameră</label>
                    <input asp-for="Tip_Camera" class="form-control" />
                    <span asp-validation-for="Tip_Camera" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Pret" class="fw-bold">Preț (RON / noapte)</label>
                    <input asp-for="Pret" class="form-control" type="number" step="0.01" min="1" />
                    <span asp-validation-for="Pret" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Descriere" class="fw-bold">Descriere</label>
                    <textarea asp-for="Descriere" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descriere" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" asp-route-lantId="@ViewBag.LantId"
                       class="btn btn-outline-secondary px-4">Anulează</a>
                    <button type="submit" class="btn btn-warning px-4 fw-bold"
                            style="color: white;">
                        Salvează Modificările
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
