@model IEnumerable<Lant_Hotelier.Models.Evenimente>
@{ ViewData["Title"] = "Evenimente"; }

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="fw-bold">📅 Evenimente</h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" asp-route-lantId="@ViewBag.LantId"
               class="btn fw-bold shadow-sm" style="background-color: #ff74a4; color: white; border: none;">
                + Adaugă Eveniment
            </a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-pink rounded-4 shadow-sm overflow-hidden">
                    @if (!string.IsNullOrEmpty(item.ImagineUrl))
                    {
                        <img src="@item.ImagineUrl" class="card-img-top"
                             style="height: 200px; object-fit: cover;" alt="@item.Titlu"
                             onerror="this.style.display='none'" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center"
                             style="height: 200px; background-color: #fff0f6;">
                            <span style="font-size: 4rem;">📅</span>
                        </div>
                    }
                    <div class="card-body p-4 text-center">
                        <div class="badge-date mb-3 mx-auto">📅 @item.DataSiOra</div>
                        <p class="text-uppercase fw-bold small mb-2" style="color: #d63384;">📍 @item.Locatie</p>
                        <h4 class="fw-bold mb-2">@item.Titlu</h4>
                        <p class="text-muted small mb-2">🏨 Lanț: @item.LantHotelier?.Nume_Lant</p>
                        <p class="text-secondary small">@item.Descriere</p>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="card-footer bg-transparent border-0 d-flex justify-content-center gap-2 pb-4">
                            <a asp-action="Edit" asp-route-id="@item.ID_Eveniment"
                               asp-route-lantId="@ViewBag.LantId"
                               class="btn btn-sm btn-outline-warning">Editează</a>
                            <form asp-action="Delete" asp-route-id="@item.ID_Eveniment"
                                  asp-route-lantId="@ViewBag.LantId" method="post"
                                  onsubmit="return confirm('Sigur ștergi?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Șterge</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert-empty">Nu există evenimente pentru acest lanț hotelier.</div>
    }
</div>

<style>
    .border-pink { border: 2px solid #ffdae9 !important; }
    .badge-date {
        background-color: #fff0f6; color: #d63384;
        padding: 5px 15px; border-radius: 20px;
        font-weight: bold; font-size: 0.9rem;
        border: 1px solid #ffdae9; width: fit-content;
    }
</style>
