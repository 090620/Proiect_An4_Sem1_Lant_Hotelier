@model IEnumerable<Lant_Hotelier.Models.Galerie>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="fw-bold">Galerie Foto</h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">+ Adaugă Imagine Nouă</a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm overflow-hidden rounded-4 card-dinamic">
                    <img src="@item.CaleImagine" class="card-img-top"
                         style="height: 250px; object-fit: cover;" alt="@item.NumeImagine">
                    <div class="card-body text-center p-3">
                        <h5 class="fw-bold mb-1">@item.NumeImagine</h5>
                        <p class="text-muted small mb-0">🏨 @item.Hotel?.Nume</p>
                        <p class="small fw-bold mb-3" style="color: #d63384;">(@item.Hotel?.LantHotelier?.Nume_Lant)</p>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.ID_Galerie"
                                   class="btn btn-sm btn-outline-warning">Editează</a>
                                <form asp-action="Delete" asp-route-id="@item.ID_Galerie" method="post"
                                      onsubmit="return confirm('Ștergi această imagine?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Șterge</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert-empty">Nu există imagini în galerie.</div>
    }
</div>
