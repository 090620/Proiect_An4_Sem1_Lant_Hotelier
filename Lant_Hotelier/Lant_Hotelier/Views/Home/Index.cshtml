@{
    ViewData["Title"] = "Acasă";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-4">🏨 Lanț Hotelier</h1>
        <p class="text-muted fs-5">Sistemul de management al lanțurilor hoteliere</p>
        <hr class="border-pink mx-auto" style="width: 100px; border-width: 3px;" />
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-md-4">
            <div class="card card-dinamic h-100 text-center p-4">
                <div class="card-body">
                    <div class="mb-3" style="font-size: 3.5rem;">🏨</div>
                    <h4 class="fw-bold" style="color: #d63384;">Lanțuri Hoteliere</h4>
                    <p class="text-muted">Gestionează lanțurile hoteliere și toate resursele asociate.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a asp-controller="Lanturi" asp-action="Index"
                       class="btn w-100 fw-bold"
                       style="background-color: #ff74a4; color: white; border: none;">
                        Gestionează Lanțuri
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-dinamic h-100 text-center p-4">
                <div class="card-body">
                    <div class="mb-3" style="font-size: 3.5rem;">📸</div>
                    <h4 class="fw-bold" style="color: #d63384;">Galerie Foto</h4>
                    <p class="text-muted">Administrează imaginile și galeriile foto ale hotelurilor.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a asp-controller="Galerie" asp-action="Index"
                       class="btn w-100 fw-bold"
                       style="background-color: #ff74a4; color: white; border: none;">
                        Vezi Galeria
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <p class="text-muted small">
            Selectează un lanț hotelier pentru a accesa: Hoteluri • Camere • Servicii • Evenimente • Oferte • Recenzii
        </p>
    </div>
</div>
