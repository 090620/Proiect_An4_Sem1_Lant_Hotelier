@model Lant_Hotelier.Models.Servicii

@{
    ViewData["Title"] = "Editează Serviciu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 rounded-4 shadow-sm bg-white" style="border: 2px solid #ffdae9 !important;">
            <h2 class="fw-bold text-center mb-4" style="color: #d63384;">✨ Editează Serviciul</h2>

            <form asp-action="Edit" asp-route-lantId="@ViewBag.LantId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ID_Servicii" />
                <input type="hidden" asp-for="ID_Lant" />
                <input type="hidden" asp-for="Pret" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nume" class="fw-bold">Denumire Serviciu</label>
                    <input asp-for="Nume" class="form-control" />
                    <span asp-validation-for="Nume" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descriere" class="fw-bold">Descriere</label>
                    <textarea asp-for="Descriere" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descriere" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Iconita" class="fw-bold">Iconiță (Emoji)</label>
                    <input asp-for="Iconita" class="form-control" style="font-size: 1.5rem;" />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" asp-route-lantId="@ViewBag.LantId"
                       class="btn btn-outline-secondary px-4">Anulează</a>
                    <button type="submit" class="btn btn-warning px-4 fw-bold" style="color: white;">
                        Salvează Modificările
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
