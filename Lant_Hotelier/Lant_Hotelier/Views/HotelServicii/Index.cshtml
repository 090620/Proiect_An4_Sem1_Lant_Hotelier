@model IEnumerable<Lant_Hotelier.Models.Servicii>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="fw-bold">Servicii Hotelier</h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" asp-route-lantId="@ViewBag.LantId" class="btn btn-primary shadow-sm">+ Adaugă Serviciu</a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card card-dinamic h-100 text-center p-4 shadow-sm">
                    <div class="card-body">
                        <div class="emoji-circle mb-3 mx-auto d-flex align-items-center justify-content-center">
                            <span style="font-size: 3rem;">@item.Iconita</span>
                        </div>
                        <h3 class="fw-bold mb-2" style="color: #d63384;">@item.Nume</h3>
                        <p class="text-muted fw-bold small mb-3">🏨 @item.LantHotelier?.Nume_Lant</p>
                        <p class="text-secondary">@item.Descriere</p>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="card-footer bg-transparent border-0 d-flex justify-content-center gap-2">
                            <a asp-action="Edit" asp-route-id="@item.ID_Servicii"
                               asp-route-lantId="@ViewBag.LantId"
                               class="btn btn-sm btn-outline-warning">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.ID_Servicii"
                                  asp-route-lantId="@ViewBag.LantId" method="post"
                                  onsubmit="return confirm('Ștergi?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Șterge</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert-empty">Nu există date create pentru acest lanț hotelier.</div>
    }
</div>

<style>
    .emoji-circle {
        width: 100px; height: 100px;
        background-color: #fff0f6;
        border-radius: 50%;
        border: 2px solid #ffdae9;
    }
</style>
