<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lant_Hotelier</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lant_Hotelier.styles.css" asp-append-version="true" />
    <style>
        .border-pink { border: 2px solid #ffdae9 !important; }
        .rounded-4 { border-radius: 1.5rem !important; }
        .card-dinamic {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background-color: white;
            border: 2px solid #ffdae9 !important;
            border-radius: 1.5rem !important;
        }
        .card-dinamic:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(214, 51, 132, 0.1) !important;
        }
        .alert-empty {
            border: 2px solid #ffdae9;
            border-radius: 2rem;
            background-color: white;
            padding: 3rem;
            text-align: center;
            color: #6c757d;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
            margin-top: 20px;
        }
        .nav-link:hover { color: #d63384 !important; }
        .avatar-nav {
            width: 32px; height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #ffdae9;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Acasă</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Lanturi" asp-action="Index">🏨 Lanțuri</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Galerie" asp-action="Index">📸 Galerie</a>
                            </li>
                            @if (!string.IsNullOrEmpty(Context.Request.Query["lantId"].ToString()))
                            {
                                <li class="nav-item"><span class="nav-link disabled text-muted">|</span></li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Hoteluri" asp-action="Index" asp-route-lantId="@Context.Request.Query["lantId"]">🏨 Hoteluri</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Camere" asp-action="Index" asp-route-lantId="@Context.Request.Query["lantId"]">🛏️ Camere</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="HotelServicii" asp-action="Index" asp-route-lantId="@Context.Request.Query["lantId"]">✨ Servicii</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Evenimente" asp-action="Index" asp-route-lantId="@Context.Request.Query["lantId"]">📅 Evenimente</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Oferte" asp-action="Index" asp-route-lantId="@Context.Request.Query["lantId"]">🏷️ Oferte</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Recenzii" asp-action="Index" asp-route-lantId="@Context.Request.Query["lantId"]">⭐ Recenzii</a>
                                </li>
                                <li class="nav-item">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a class="nav-link text-danger fw-bold" asp-controller="Rezervari" asp-action="Index">📋 Toate Rezervările</a>
                                    }
                                    else
                                    {
                                        <a class="nav-link text-danger fw-bold" asp-controller="Rezervari" asp-action="RezervariMele">🏨 Rezervările Mele</a>
                                    }
                                </li>
                            }
                        }
                    </ul>

                    @* Dreapta navbar: Login/Register sau Avatar+Logout *@
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <a asp-controller="Account" asp-action="Profil"
                                   class="nav-link d-flex align-items-center gap-2 fw-bold"
                                   style="color: #d63384;">
                                    @{
                                        var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                                        var userMgr = Context.RequestServices.GetService<Microsoft.AspNetCore.Identity.UserManager<Lant_Hotelier.Models.ApplicationUser>>();
                                        var currentUser = userMgr != null ? await userMgr.FindByEmailAsync(userEmail ?? "") : null;
                                        var isAdmin = User.IsInRole("Admin");
                                    }
                                    @if (currentUser != null && !string.IsNullOrEmpty(currentUser.PozaProfil))
                                    {
                                        <img src="@currentUser.PozaProfil" class="avatar-nav" alt="Avatar"
                                             onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <span>👤</span>
                                    }
                                    @User.Identity!.Name
                                    @if (isAdmin)
                                    {
                                        <span class="badge rounded-pill ms-1" style="background:#d63384;color:white;font-size:0.65rem;">👑 Admin</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm fw-bold rounded-3"
                                            style="background-color: #ffdae9; color: #d63384; border: none;">
                                        Deconectare
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a asp-controller="Account" asp-action="Login"
                                   class="btn btn-sm fw-bold rounded-3"
                                   style="background-color: #ffdae9; color: #d63384; border: none;">
                                    🔐 Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="Register"
                                   class="btn btn-sm fw-bold rounded-3"
                                   style="background-color: #ff74a4; color: white; border: none;">
                                    ✨ Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2026 - Lant_Hotelier | <span style="color: #d63384;">Arhitectură Repository & Service Implementată</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
